# Copy this file to ".env" and edit. Everything has a safe default for local dev.

# --- White-label branding (re-skin the platform for any nutrition business) ---
APP_NAME=NutriAgent
APP_TAGLINE=AI-powered personalized nutrition & meal planning
CURRENCY_SYMBOL=$

# --- Security ---
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Database ---
# SQLite (zero setup, default):
DATABASE_URL=sqlite:///./nutriagent.db
# PostgreSQL (production / docker-compose):
# DATABASE_URL=postgresql+psycopg2://nutri:nutri@localhost:5432/nutriagent

# --- Seed accounts (created on first start if missing) ---
ADMIN_EMAIL=admin@nutriagent.dev
ADMIN_PASSWORD=Admin@123
DEMO_EMAIL=demo@nutriagent.dev
DEMO_PASSWORD=Demo@123

# --- Optional FREE LLM for the AI Coach (Google AI Studio free tier) ---
# Get a key at https://aistudio.google.com/apikey  -- leave blank to use the built-in offline coach
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Store rules ---
TAX_RATE=0.08
SHIPPING_FLAT=4.99
FREE_SHIPPING_OVER=50
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
